# Secrets — ignore contents but allow config_bad.json (no real secrets)
**/secrets/*
!**/secrets/config_bad.json
!**/secrets/.gitignore
*.secret
.env
*.env
.env.*

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/

# Test cache
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp

# Virtual env
.venv/
venv/
